FLASK_ENV=development
SECRET_KEY=change-this-secret-in-production
JWT_SECRET_KEY=change-this-secret-in-production
DATABASE_URL=sqlite:///data/maintenance.db
AUTO_CREATE_DATABASE=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_BALANCED=gpt-4o-mini
OPENAI_MODEL_QUALITY=gpt-5-mini
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=1
AI_ENABLE_STREAMING=true
# Optional cost analytics. Values are USD per 1M tokens and default to 0 if unset.
AI_PRICE_GPT_5_4_NANO_INPUT_PER_1M=
AI_PRICE_GPT_5_4_NANO_CACHED_INPUT_PER_1M=
AI_PRICE_GPT_5_4_NANO_OUTPUT_PER_1M=
AI_PRICE_GPT_5_4_MINI_INPUT_PER_1M=
AI_PRICE_GPT_5_4_MINI_CACHED_INPUT_PER_1M=
AI_PRICE_GPT_5_4_MINI_OUTPUT_PER_1M=
AI_PRICE_GPT_5_4_INPUT_PER_1M=
AI_PRICE_GPT_5_4_CACHED_INPUT_PER_1M=
AI_PRICE_GPT_5_4_OUTPUT_PER_1M=
UPLOAD_FOLDER=data/uploads
DOCUMENTS_FOLDER=documents
MANUALS_FOLDER=manuals
BACKUP_FOLDER=backups
LOG_DIR=logs
LOG_LEVEL=INFO
SLOW_REQUEST_THRESHOLD_MS=500
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
MAIL_DRY_RUN=true
DAILY_BRIEFING_TIME=07:00
TASK_REMINDER_LOOKBACK_HOURS=24
AI_ALERT_LOOKBACK_MINUTES=60

# Optional production bootstrap for `python seed.py production`.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
